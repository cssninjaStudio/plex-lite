<div x-data="initCompressedSidebar()" class="plex-compressed-sidebar" :class=`{
        'is-inactive': !$store.app.isLayoutExpanded,
        '': $store.app.isLayoutExpanded
    }`>
  <div class="compressed-header">
    <h3><a href="/">P</a></h3>
  </div>
  <div class="compressed-item is-bordered">
    <button @click="toggleSidebar()" class="menu-icon v-5">
      <span></span>
    </button>
  </div>
  <div class="compressed-menu">
    <a href="/#dashboard-accounting" class="compressed-item" :class="{'is-active': window.location.href.includes('dashboard')}">
      <iconify-icon class="iconify" icon="lucide:grid"></iconify-icon>
    </a>
    <a href="/#content-project-list" class="compressed-item" :class="{'is-active': window.location.href.includes('project')}">
      <iconify-icon class="iconify" icon="lucide:layers"></iconify-icon>
    </a>
    <a href="/#content-crm-segments" class="compressed-item" :class="{'is-active': window.location.href.includes('crm')}">
      <iconify-icon class="iconify" icon="lucide:briefcase"></iconify-icon>
    </a>
    <a href="/#content-invoices-list" class="compressed-item" :class="{'is-active': window.location.href.includes('invoice')}">
      <iconify-icon class="iconify" icon="lucide:file-text"></iconify-icon>
    </a>
    <a href="/#content-bills-list" class="compressed-item" :class="{'is-active': window.location.href.includes('bill')}">
      <iconify-icon class="iconify" icon="lucide:file"></iconify-icon>
    </a>
    <a href="/#content-contact-list" class="compressed-item" :class="{'is-active': window.location.href.includes('contact')}">
      <iconify-icon class="iconify" icon="lucide:users"></iconify-icon>
    </a>
    <a href="/#content-forum-index" class="compressed-item" :class="{'is-active': window.location.href.includes('forum')}">
      <iconify-icon class="iconify" icon="lucide:message-circle"></iconify-icon>
    </a>
    <a href="/#content-inbox" class="compressed-item" :class="{'is-active': window.location.href.includes('inbox')}">
      <iconify-icon class="iconify" icon="lucide:mail"></iconify-icon>
    </a>
    <a href="/#settings" class="compressed-item" :class="{'is-active': window.location.href.includes('settings')}">
      <iconify-icon class="iconify" icon="lucide:settings"></iconify-icon>
    </a>
    <div class="compressed-naver"></div>
  </div>
</div>
