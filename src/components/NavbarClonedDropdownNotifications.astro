<div x-data="initDropdown()" @click.away="close()" class="dropdown-wrap is-right" :class=`{
  'is-active': open,
  '': !open
}`>
  <span class="indicator"></span>
  <button @click="toggle()" class="dropdown-button">
    <iconify-icon class="iconify" icon="lucide:bell"></iconify-icon>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Notifications</h3>
        <a>All</a>
      </div>
      <div class="notification-items">
        <div class="notification-item">
          <div class="avatar is-list-icon">
            <iconify-icon class="iconify" icon="lucide:file-text"></iconify-icon>
          </div>
          <div class="notification-content">
            <p><a>5 new invoices</a> were recently added</p>
            <small>3 hours ago</small>
          </div>
        </div>
        <div class="notification-item">
          <div class="avatar is-list-icon">
            <iconify-icon class="iconify" icon="lucide:file-text"></iconify-icon>
          </div>
          <div class="notification-content">
            <p><a>3 invoices</a> were marked as approved</p>
            <small>5 hours ago</small>
          </div>
        </div>
        <div class="notification-item is-warning">
          <div class="avatar is-list-icon">
            <iconify-icon class="iconify" icon="lucide:alert-octagon"></iconify-icon>
          </div>
          <div class="notification-content">
            <p>Some items managed by you are on <a>overdue</a></p>
            <small>5 hours ago</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
