<div x-data="initDropdown()" @click.away="close()" class="dropdown-wrap is-right" :class=`{
  'is-active': open,
  '': !open
}`>
<button @click="toggle()" class="dropdown-button">
<iconify-icon class="iconify" icon="lucide:more-horizontal"></iconify-icon>
</button>
<div class="drop-menu">
<div class="menu-inner">
  <div class="menu-header">
    <h3>Activity</h3>
  </div>
  <div class="options-items">
    <a class="options-item">
      <iconify-icon class="iconify" icon="ph:heartbeat-duotone"></iconify-icon>
      <div class="option-content">
        <span>All Activity</span>
        <span>See all activity</span>
      </div>
    </a>
    <a class="options-item">
      <iconify-icon class="iconify" icon="ph:calendar-check-duotone"></iconify-icon>
      <div class="option-content">
        <span>This week</span>
        <span>View last week activity</span>
      </div>
    </a>
    <a class="options-item">
      <iconify-icon class="iconify" icon="ph:circles-three-plus-duotone"></iconify-icon>
      <div class="option-content">
        <span>By Team</span>
        <span>View team based activity</span>
      </div>
    </a>
  </div>
</div>
</div>
</div>
