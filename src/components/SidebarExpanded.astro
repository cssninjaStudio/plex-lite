<div
  x-data="initSidebar()"
  class="plex-sidebar"
  :class="{
        'is-inactive': $store.app.isLayoutExpanded,
        '': !$store.app.isLayoutExpanded,
        'is-mobile-active': $store.app.isMobileActive,
        '': !$store.app.isMobileActive
    }"
>
  <div class="sidebar-header">
    <h3><a href="/">Plex</a></h3>
    <button
      @click="toggleSidebar()"
      class="menu-icon v-5 is-hidden-mobile b-hidden-tablet-l b-hidden-tablet-p"
    >
      <span></span>
    </button>
    <button
      @click="toggleMobileMenu()"
      class="menu-icon v-5 is-open mobile-item is-block mobile-sidebar-trigger"
    >
      <span></span>
    </button>
  </div>
  <div class="sidebar-profile">
    <div class="avatar-container">
      <div class="avatar-wrapper">
        <div class="avatar is-lg">
          <img src="/img/avatars/25.jpg" alt="" />
          <span class="badge">
            <i class="iconify" data-icon="feather:check"></i>
          </span>
        </div>
        <h3>Anthony Miller</h3>
        <p>Accountant</p>
      </div>
    </div>
  </div>
  <div class="sidebar-menu has-slimscroll">
    <a
      href="/#dashboard-accounting"
      class="menu-item"
      :class="{'is-active': window.location.href.includes('dashboard')}"
    >
      <i class="iconify" data-icon="feather:grid"></i>
      <span>Dashboard</span>
    </a>
    <a
      href="/#content-project-list"
      class="menu-item"
      :class="{'is-active': window.location.href.includes('project')}"
    >
      <i class="iconify" data-icon="feather:layers"></i>
      <span>Projects</span>
    </a>
    <a
      href="/#content-crm-segments"
      class="menu-item"
      :class="{'is-active': window.location.href.includes('crm')}"
    >
      <i class="iconify" data-icon="feather:briefcase"></i>
      <span>Deals</span>
    </a>
    <a
      href="/#content-invoices-list"
      class="menu-item"
      :class="{'is-active': window.location.href.includes('invoice')}"
    >
      <i class="iconify" data-icon="feather:file-text"></i>
      <span>Invoices</span>
    </a>
    <a
      href="/#content-bills-list"
      class="menu-item"
      :class="{'is-active': window.location.href.includes('bill')}"
    >
      <i class="iconify" data-icon="feather:file"></i>
      <span>Bills</span>
    </a>
    <a
      href="/#content-contact-list"
      class="menu-item"
      :class="{'is-active': window.location.href.includes('contact')}"
    >
      <i class="iconify" data-icon="feather:users"></i>
      <span>Contacts</span>
    </a>
    <a
      href="/#content-forum-index"
      class="menu-item"
      :class="{'is-active': window.location.href.includes('forum')}"
    >
      <i class="iconify" data-icon="feather:message-circle"></i>
      <span>Forum</span>
    </a>
    <a
      href="/#content-inbox"
      class="menu-item"
      :class="{'is-active': window.location.href.includes('inbox')}"
    >
      <i class="iconify" data-icon="feather:mail"></i>
      <span>Messages</span>
    </a>
    <a
      href="/#content-settings"
      class="menu-item"
      :class="{'is-active': window.location.href.includes('settings')}"
    >
      <i class="iconify" data-icon="feather:settings"></i>
      <span>Settings</span>
    </a>
    <div class="naver"></div>
  </div>
</div>
